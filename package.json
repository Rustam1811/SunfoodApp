{
    "name": "SunfoodApp",
    "private": true,
    "version": "1.0.0",
    "scripts": {
        "dev": "npm run dev:web",
    "dev:web": "cross-env NODE_ENV=development vite",
    "dev:client": "cd client && npm run dev",
    "dev:admin": "cross-env NODE_ENV=development vite --config admin/vite.config.ts",
        "dev:landing": "cd public/landing && npm run dev",
        "dev:api": "node api-server.js",
        "dev:functions": "firebase emulators:start --only functions",
        "dev:local": "concurrently -n API,WEB,ADMIN -c cyan,magenta,green \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:admin\"",
        "dev:firebase": "concurrently -n FUNCTIONS,WEB,ADMIN -c cyan,magenta,green \"firebase emulators:start --only functions\" \"npm run dev:web\" \"npm run dev:admin\"",
        "seed:dev": "node scripts/seed-dev.js",
    "build": "npm run build:web",
        "typecheck": "tsc --noEmit",
        "export-admin": "cd admin && npm ci && npm run build",
        "export-landing": "cd public/landing && npm ci && npm run build",
        "deploy": "npm run build:web && firebase deploy --only hosting",
        "preview": "vite preview",
        "test.e2e": "cypress run",
        "test.unit": "vitest",
        "lint": "eslint",
    "build:web": "vite build",
    "build:client": "cd client && npm run build",
    "build:admin": "cd admin && npm run build",
    "build:landing": "cd public/landing && npm run build",
    "build:all": "npm run build:client && npm run build:admin && npm run build:landing && npm run clean:landing",
        "clean:landing": "node -e \"const fs=require('fs');const p='dist/app/landing';if(fs.existsSync(p))fs.rmSync(p,{recursive:true})\"",
        "preview:web": "vite preview --port 4173",
        "preview:admin": "vite preview --config admin/vite.config.ts --port 4174",
        "preview:landing": "cd public/landing && npm run preview"
    },
    "dependencies": {
        "@capacitor/app": "7.0.0",
        "@capacitor/haptics": "7.0.0",
        "@capacitor/keyboard": "7.0.0",
        "@capacitor/status-bar": "7.0.0",
        "@emailjs/browser": "^4.4.1",
        "@heroicons/react": "^2.2.0",
        "@prisma/client": "^6.5.0",
        "@splidejs/react-splide": "^0.7.12",
        "@types/busboy": "^1.5.4",
        "@types/react-router": "^5.1.20",
        "@types/react-router-dom": "^5.3.3",
        "@types/recharts": "^1.8.29",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.2",
        "busboy": "^1.6.0",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.21.2",
        "firebase": "^12.6.0",
        "firebase-admin": "^13.3.0",
        "firebase-functions": "^6.4.0",
        "fix": "^0.0.6",
        "framer-motion": "^12.23.12",
        "i18next-http-backend": "^3.0.2",
        "jose": "^6.0.10",
        "jsonwebtoken": "^9.0.2",
        "konva": "^9.3.22",
        "lucide-react": "^0.515.0",
        "mongoose": "^8.13.1",
        "multer": "^2.0.2",
        "nanoid": "^5.1.5",
        "node-fetch": "^2.7.0",
        "qrcode.react": "^4.2.0",
        "react": "^18.2.0",
        "react-countup": "^6.5.3",
        "react-dom": "^18.2.0",
        "react-i18next": "^15.5.3",
        "react-insta-stories": "^2.8.0",
        "react-konva": "^18.2.10",
        "react-router": "^5.3.4",
        "react-router-dom": "^5.3.4",
        "react-swipeable": "^7.0.2",
        "recharts": "^2.15.4",
        "split.js": "^1.6.5",
        "swiper": "^9.4.1",
        "tailwind-scrollbar-hide": "^4.0.0",
        "vercel": "^41.4.1"
    },
    "engines": {
        "node": "20.x"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.5",
        "@testing-library/dom": ">=7.21.4",
        "@testing-library/jest-dom": "^5.16.5",
        "@testing-library/react": "^14.0.0",
        "@testing-library/user-event": "^14.4.3",
        "@types/cors": "^2.8.17",
        "@types/jest": "^29.5.14",
        "@types/react": "^18.0.27",
        "@types/react-dom": "^18.0.10",
        "@types/three": "^0.174.0",
        "@vercel/node": "^5.1.14",
        "@vitejs/plugin-legacy": "^5.0.0",
        "@vitejs/plugin-react": "^4.4.1",
        "autoprefixer": "^10.4.21",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "cypress": "^13.5.0",
        "depcheck": "^1.4.7",
        "eslint": "^9.20.1",
        "eslint-plugin-react": "^7.32.2",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "firebase-tools": "^13.0.0",
        "globals": "^15.15.0",
        "jsdom": "^22.1.0",
        "knip": "^5.63.0",
        "postcss": "^8.5.3",
        "prisma": "^6.5.0",
        "qrcode-terminal": "^0.12.0",
        "react-icons": "^5.5.0",
        "tailwindcss": "^4.0.12",
        "terser": "^5.4.0",
        "three": "^0.176.0",
        "ts-prune": "^0.10.3",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.24.0",
        "vite": "~5.2.0",
        "vite-plugin-pwa": "^1.0.0",
        "vite-plugin-static-copy": "^3.1.4",
        "vitest": "^0.34.6"
    },
    "description": "An project"
}
