rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Sessions - anyone can create, only owner can read/delete
    match /sessions/{token} {
      allow create: if true;
      allow read, delete: if true; // Will be validated in app logic
    }
    
    // Users - anyone can read, only the user can update themselves
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true; // Registration/profile updates
      allow delete: if false; // Never delete users
    }
    
    // Everything else - open for now (TODO: restrict for production)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}