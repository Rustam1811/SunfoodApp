# Firebase Environment Variables for Web (Vite)
# Copy to .env.local and fill with your Firebase project values

# Note: Code uses VITE_FIREBASE_* prefix (see src/lib/firebase.ts)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=gym-vantero.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gym-vantero
VITE_FIREBASE_STORAGE_BUCKET=gym-vantero.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=59191748610
VITE_FIREBASE_APP_ID=your-app-id-here
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Cloud Messaging (FCM) - Web Push VAPID Key
VITE_FIREBASE_VAPID_KEY=your-vapid-key-here

# Firebase Admin SDK для API endpoints (Vercel/Functions)
FIREBASE_PROJECT_ID=gym-vantero
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@gym-vantero.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----"
FIREBASE_STORAGE_BUCKET=gym-vantero.firebasestorage.app

# Example (replace with your values):
# VITE_FIREBASE_API_KEY=AIzaSyDjX8QvyvHr4jc0pKyDHRMbOWw3GvFZInM
# VITE_FIREBASE_AUTH_DOMAIN=rauanagym.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=rauanagym
# VITE_FIREBASE_STORAGE_BUCKET=rauanagym.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=111319094046
# VITE_FIREBASE_APP_ID=1:111319094046:web:69a3b90cea2fca99096f0f
# VITE_FIREBASE_MEASUREMENT_ID=G-QVW2VBK7CL
# VITE_FCM_VAPID_KEY=BG1234567890abcdefghijklmnopqrstuvwxyz...

# Firebase Admin Example:
# FIREBASE_PROJECT_ID=rauanagym
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@rauanagym.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----"
