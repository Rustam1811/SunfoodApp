// Firestore Security Rules
// Copy this to Firebase Console → Firestore → Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Stories collection - public read, admin write
    match /stories/{storyId} {
      // Allow public read for all stories
      allow read: if true;
      
      // Allow write only for authenticated admin users
      // For now, allow all writes (dev mode)
      allow write: if true;
      
      // For production with role field, use:
      // allow write: if request.auth != null && 
      //   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
      //   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Orders collection - admin/barista/courier access
    match /orders/{orderId} {
      // Allow read/write for authenticated admin users (dev mode - allow all authenticated)
      allow read, write: if request.auth != null;
      
      // Production: restrict by role
      // allow read, write: if request.auth != null && 
      //   request.auth.token.email in ['admin121@gmail.com', 'barista121@gmail.com', 'courier121@gmail.com'];
      
      // Status history subcollection
      match /statusHistory/{historyId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Users collection - admin access + user can update own phone
    match /users/{userId} {
      // Allow read/write for authenticated admin users
      allow read, write: if request.auth != null && 
        request.auth.token.email in ['admin121@gmail.com', 'barista121@gmail.com'];
      
      // Allow user to read their own document
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow user to create their own document with required fields
      allow create: if request.auth != null && 
        request.auth.uid == userId &&
        request.resource.data.keys().hasAny(['phone', 'email', 'name']);
      
      // Allow user to update their own document (phone, name, email, avatar, notification preferences, fcmToken, updatedAt)
      allow update: if request.auth != null && 
        request.auth.uid == userId && 
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['phone', 'name', 'email', 'avatar', 'updatedAt', 'pushOptIn', 'marketingOptIn', 'subscribePromotions', 'subscribeStories', 'lastOrderAt', 'fcmToken', 'notificationsEnabled', 'lastTokenUpdate']);
      
      // FCM tokens subcollection - user can manage their own tokens
      match /tokens/{tokenId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Notification suppression subcollection - only Cloud Functions can write
      match /notifications_suppress/{type} {
        allow read, write: if false; // Only Cloud Functions can access
      }
    }
    
    // Categories collection - admin write, public read
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && 
        request.auth.token.email in ['admin121@gmail.com', 'barista121@gmail.com'];
    }
    
    // Promotions collection - admin write, public read
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if request.auth != null && 
        request.auth.token.email in ['admin121@gmail.com', 'barista121@gmail.com'];
    }
    
    // News collection (alternative to promotions) - admin write, public read
    match /news/{newsId} {
      allow read: if true;
      allow write: if request.auth != null && 
        request.auth.token.email in ['admin121@gmail.com', 'barista121@gmail.com'];
    }
    
    // Notifications log collection - only Cloud Functions can write, admin can read
    match /notifications_log/{logId} {
      allow read: if request.auth != null;
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Bonuses collection - users can read their own, admin can read/write all
    match /bonuses/{userId} {
      allow read: if request.auth != null && 
        (request.auth.uid == userId || request.auth.token.email in ['admin121@gmail.com', 'barista121@gmail.com']);
      allow write: if request.auth != null;
    }
    
    // Bonus settings collection - admin write, public read
    match /bonusSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Courier locations collection - courier can update their own, admin can read all
    match /courierLocations/{courierId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.uid == courierId || request.auth.token.email in ['admin121@gmail.com', 'courier121@gmail.com']);
    }
    
    // Counters collection - allow read/write for backend operations
    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }
    
    // All other collections - deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
